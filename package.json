{
    "name": "@liustack/beastcover",
    "version": "0.5.0",
    "description": "Covers that get the click, for WeChat, X, YouTube, Xiaohongshu, Douyin and more: your agent picks a free photo, adds your headline and palette, and renders it locally",
    "type": "module",
    "bin": {
        "beastcover": "dist/main.js"
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "lint": "biome check src dsh scripts",
        "format": "biome check --write src dsh scripts",
        "check": "pnpm typecheck && pnpm lint && pnpm test",
        "release": "node scripts/release.mjs",
        "prepublishOnly": "pnpm build"
    },
    "files": [
        "dist",
        "skills/beastcover/SKILL.md",
        "dsh/index.js",
        "cordis.patch.yml",
        "README.md",
        "README.zh-CN.md",
        "CHANGELOG.md"
    ],
    "keywords": [
        "cli",
        "cover-image",
        "article-cover",
        "thumbnail",
        "youtube-thumbnail",
        "stock-photos",
        "openverse",
        "pexels",
        "html-to-png",
        "playwright",
        "agent-skill",
        "claude-code",
        "codex",
        "beastcover"
    ],
    "author": "Leon Liu",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liustack/beastcover.git"
    },
    "bugs": {
        "url": "https://github.com/liustack/beastcover/issues"
    },
    "homepage": "https://github.com/liustack/beastcover#readme",
    "engines": {
        "node": ">=22.19"
    },
    "packageManager": "pnpm@10.33.0",
    "dependencies": {
        "commander": "^13.1.0",
        "playwright": "^1.62.1",
        "sharp": "^0.35.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@types/node": "^22.19.7",
        "@vitest/coverage-v8": "^3.2.7",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vitest": "^3.2.7"
    },
    "exports": {
        ".": "./dsh/index.js",
        "./dsh": "./dsh/index.js",
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
